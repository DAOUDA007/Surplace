{
  "name": "surplace-backend",
  "version": "0.1.0",
  "private": true,
  "description": "SURPLACE — API (Express + SQLite)",
  "scripts": {
    "predev": "node ../scripts/sync-commun.mjs",
    "dev": "tsx watch src/server.ts",
    "prestart": "node ../scripts/sync-commun.mjs",
    "start": "tsx src/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/api.test.ts",
    "reset-admin-pin": "tsx scripts/reset-admin-pin.ts",
    "backup": "tsx scripts/backup.ts"
  },
  "dependencies": {
    "better-sqlite3": "^12.11.1",
    "cookie-parser": "^1.4.7",
    "express": "^4.22.3",
    "nodemailer": "^10.0.14",
    "surplace": "file:..",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^4.17.25",
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^8.0.2",
    "@types/web-push": "^3.6.4",
    "tsx": "^4.23.15",
    "typescript": "5.9"
  }
}
