# Copiez ce fichier en « .env » (dans le dossier Backend) puis remplissez les valeurs.
# Le fichier .env contient des secrets : ne le partagez jamais et ne le publiez pas.

# --- Premier administrateur (base neuve uniquement) ---
# Si la base ne contient aucun administrateur, il est créé au démarrage avec ce numéro et ce code PIN.
# Il n'existe plus de compte de démonstration. Une fois connecté, vous pouvez retirer ADMIN_PIN.
ADMIN_PHONE=0574328818
ADMIN_PIN=0613
# ADMIN_NAME=Administrateur

# --- Adresses publiques (liens dans les e-mails, SMS et notifications) ---
SITE_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001

# --- Envoi des e-mails avec Gmail ---
# 1. Utilisez le compte Gmail de SURPLACE (ex. surplace.korhogo@gmail.com).
# 2. Activez la validation en deux étapes : https://myaccount.google.com/security
# 3. Créez un « mot de passe d'application » : https://myaccount.google.com/apppasswords
#    (Google affiche 16 lettres, ex. « abcd efgh ijkl mnop » : collez-les ci-dessous).
SMTP_USER=
SMTP_PASS=
# Nom de l'expéditeur affiché dans la boîte de réception.
MAIL_FROM_NAME=SURPLACE

# --- SMS (codes de vérification, rappels, alertes d'urgence) ---
# Sans configuration, aucun SMS ne part : ils sont affichés dans la console et enregistrés dans data/sms/.
# En développement, lisez alors le code dans le terminal du serveur (il n'est jamais affiché à l'écran).
# En production SANS fournisseur, la vérification par SMS est désactivée (sinon personne ne pourrait s'inscrire).
#
# Orange SMS API (Côte d'Ivoire) : créez une application sur https://developer.orange.com
# et souscrivez à l'offre « SMS Côte d'Ivoire ».
SMS_PROVIDER=console
ORANGE_CLIENT_ID=
ORANGE_CLIENT_SECRET=
# Numéro d'expéditeur fourni par Orange, au format +225XXXXXXXXXX (souvent +2250000).
ORANGE_SENDER=
# Nom affiché à la place du numéro (si Orange l'a validé), ex. SURPLACE.
ORANGE_SENDER_NAME=

# --- Notifications push (téléphones) ---
# Laissez vide : des clés sont créées au premier démarrage et gardées dans data/vapid.json.
# Si vous les renseignez, ne les changez plus ensuite (les téléphones abonnés seraient perdus).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contact@surplace.ci

# --- Itinéraires routiers (distance par la route au lieu de la ligne droite) ---
# Vide : serveur OSRM public et gratuit d'OpenStreetMap (routing.openstreetmap.de).
# Votre propre serveur OSRM : ex. http://localhost:5000 (voir deploy/DEPLOIEMENT.md).
# off : distance à vol d'oiseau × facteur route (réglable dans l'administration).
OSRM_URL=

# --- Base de données et sauvegardes ---
# SURPLACE_DB=/var/lib/surplace/surplace.db
# SURPLACE_BACKUP_DIR=/var/backups/surplace
